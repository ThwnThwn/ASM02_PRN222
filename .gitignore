# ========================
*.pubxml
*.pubxml.user
**/Properties/PublishProfiles/

# ========================
# Test results
# ========================
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
TestResult.xml

