# ========================
project.lock.json
project.fragment.lock.json
*.publishsettings
orleans.codegen.cs

# ========================
# ASP.NET Core
# ========================
**/wwwroot/lib/
**/bundleconfig.json
appsettings.Development.json
appsettings.Production.json
