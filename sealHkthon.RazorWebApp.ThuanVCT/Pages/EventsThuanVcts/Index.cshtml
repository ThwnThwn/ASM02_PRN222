@page
@model sealHkthon.RazorWebApp.ThuanVCT.Pages.EventsThuanVcts.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<div class="row">
    <form method="get">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="form-label"></label>
                    <input asp-for="@Model.eventName" class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="form-label"></label>
                    <input asp-for="@Model.roundName" class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="form-label"></label>
                    <input asp-for="@Model.status" class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <input type="submit" value="Search" class="btn btn-sm btn-primary"></>
            </div>


        </div>
    </form>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EventsThuanVct[0].EventName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventsThuanVct[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventsThuanVct[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventsThuanVct[0].PublishDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventsThuanVct[0].IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.EventsThuanVct) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.EventName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PublishDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.EventThuanVctid">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.EventThuanVctid">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.EventThuanVctid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
